    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
